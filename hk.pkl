amends "package://github.com/jdx/hk/releases/download/v1.48.0/hk@1.48.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.48.0/hk@1.48.0#/Builtins.pkl"

local jsTsGlobs =
  List(
    "**/*.js",
    "**/*.jsx",
    "**/*.mjs",
    "**/*.cjs",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    "**/*.cts",
  )

// Cheap safety nets: large files, private keys, stray merge markers.
local safety = new Mapping<String, Step> {
  ["check-added-large-files"] = (Builtins.check_added_large_files) {
    exclude = List("pnpm-lock.yaml")
  }
  ["detect-private-key"] = Builtins.detect_private_key
  ["check-merge-conflict"] = Builtins.check_merge_conflict
}

// Config-file linters that don't run through pnpm.
local configChecks = new Mapping<String, Step> {
  ["pkl-format"] = Builtins.pkl_format
  ["pkl"] = Builtins.pkl
  ["mise"] = Builtins.mise
}

// Auto-fixing formatters — fast enough for every commit.
local formatters = new Group {
  prefix = "pnpm"
  steps {
    ["oxfmt"] {
      glob = jsTsGlobs
      check = "oxfmt --check {{ files }}"
      fix = "oxfmt {{ files }}"
    }
  }
}

// Blocking checks — run on pre-push, not every commit.
local linters = new Group {
  prefix = "pnpm"
  steps {
    ["oxlint"] = (Builtins.ox_lint) {
      glob = jsTsGlobs
      check = "oxlint {{ files }}"
    }
    ["typecheck"] = (Builtins.tsc) {
      check = "tsgo --build"
    }
  }
}

// `vitest related` scopes the run to tests impacted by staged files, so a
// 10-file commit no longer triggers 10 full-suite runs.
local tests = new Group {
  prefix = "pnpm"
  steps {
    ["vitest"] {
      glob = jsTsGlobs
      check = "vitest related {{ files }} --run --silent --reporter=dot"
    }
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps {
      ...safety
      ...configChecks
      ["formatters"] = formatters
    }
  }
  ["pre-push"] {
    steps {
      ...safety
      ...configChecks
      ["formatters"] = formatters
      ["linters"] = linters
      ["tests"] = tests
    }
  }
  ["fix"] {
    fix = true
    steps {
      ...configChecks
      ["formatters"] = formatters
      ["linters"] = linters
    }
  }
  ["check"] {
    steps {
      ...safety
      ...configChecks
      ["formatters"] = formatters
      ["linters"] = linters
      ["tests"] = tests
    }
  }
}
