# Required
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:3000 # Public origin used to build the OAuth redirect URI (e.g. https://sync.example.com)

# Optional (for quota discovery from Google API)
# GOOGLE_PROJECT_NUMBER=123456789

# Optional
ARCHIVE_PATH=./fixtures/archive
DATA_PATH=./data
PORT=3000
DAILY_QUOTA_LIMIT=10000
UPLOAD_COST=100
UPLOAD_INTERVAL_MS=1000
ARCHIVE_POLL_INTERVAL_MS=900000
MAX_RETRY_COUNT=3
LOG_LEVEL=info
DRY_RUN=false
SYNC_MODE=auto # "auto" starts uploading immediately, "manual" waits for API trigger

# Video description template. Uses {{ variable }} interpolation.
# Available: clip_id, url, embed_url, broadcaster_id, broadcaster_name,
#   creator_id, creator_name, game_id, language, title, view_count,
#   created_at, created_at_formatted, thumbnail_url,
#   clip_archived, thumbnail_archived, deleted_on_twitch
# DESCRIPTION_TEMPLATE=Clipped by {{ creator_name }}, {{ created_at_formatted }}.\n\nOriginal clip: {{ url }}

ADMIN_PASSWORD=
WEBHOOK_URL=
WEBHOOK_EVENTS=upload:success,quota:exhausted
